{
    "name": "backfron/laravel-finder",
    "description": "Build and handle complex Eloquent searchs easely.",
    "license": "MIT",
    "authors": [
        {
            "name": "Jairo Ushiña",
            "email": "jago86@gmail.com",
            "homepage": "https://backfron.com"
        }
    ],
    "homepage": "https://github.com/backfron/laravel-finder",
    "keywords": [
        "Laravel",
        "LaravelFinder"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11|^12"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0.1",
        "orchestra/testbench": "~10.2.1"
    },
    "autoload": {
        "psr-4": {
            "Backfron\\LaravelFinder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Backfron\\LaravelFinder\\Tests\\": "tests",
            "App\\": "vendor/orchestra/testbench-core/laravel/app",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Backfron\\LaravelFinder\\LaravelFinderServiceProvider"
            ],
            "aliases": {
                "LaravelFinder": "Backfron\\LaravelFinder\\Facades\\LaravelFinder"
            }
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ]
    }
}
